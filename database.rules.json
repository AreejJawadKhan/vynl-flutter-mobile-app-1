{
  "rules": {
    ".read": false,
    ".write": false,
    "nowPlaying": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid",
        "listeningHistory": {
          ".read": "auth != null",
          "$entryId": {
            ".write": "auth != null && auth.uid == $uid"
          }
        }
      }
    },
    "songMeta": {
      ".read": "auth != null",
      "$songKey": {
        ".write": "auth != null"
      }
    },
    "rooms": {
      "$code": {
        ".read": "auth != null && root.child('rooms').child($code).child('participants').child(auth.uid).exists()",
        ".write": "auth != null && (!data.exists() || root.child('rooms').child($code).child('participants').child(auth.uid).exists() || newData.child('hostId').val() == auth.uid)",
        "participants": {
          "$participantId": {
            ".write": "auth != null && auth.uid == $participantId"
          }
        },
        "queue": {
          "$itemId": {
            ".write": "auth != null && root.child('rooms').child($code).child('participants').child(auth.uid).exists()"
          }
        },
        "messages": {
          "$messageId": {
            ".write": "auth != null && root.child('rooms').child($code).child('participants').child(auth.uid).exists()"
          }
        },
        "voters": {
          "$voterId": {
            ".write": "auth != null && auth.uid == $voterId && root.child('rooms').child($code).child('participants').child(auth.uid).exists()"
          }
        }
      }
    }
  }
}
