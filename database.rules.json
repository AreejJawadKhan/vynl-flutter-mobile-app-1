{
  "rules": {
    ".read": false,
    ".write": false,

    "nowPlaying": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid",
        "listeningHistory": {
          ".read": "auth != null",
          "$entryId": {
            ".write": "auth != null && auth.uid == $uid"
          }
        }
      }
    },

    "songMeta": {
      ".read": "auth != null",
      "$songKey": {
        ".write": "auth != null"
      }
    },

    "rooms": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "feed": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
